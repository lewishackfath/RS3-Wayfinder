APP_NAME="RS3 Wayfinder"
APP_URL="https://wayfinder.example.com"
APP_ENV="production"
APP_DEBUG="false"
APP_TIMEZONE="Australia/Sydney"

DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="rs3_wayfinder"
DB_USER="rs3_wayfinder"
DB_PASS="change-me"
DB_CHARSET="utf8mb4"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="https://wayfinder.example.com/auth/callback.php"
DISCORD_SCOPES="identify email"

SESSION_NAME="rs3_wayfinder_session"
SESSION_SECURE="true"

# Comma-separated Discord user IDs that should receive Owner on login.
ADMIN_DISCORD_IDS=""
# Login persistence
SESSION_LIFETIME_SECONDS=2592000
REMEMBER_COOKIE_NAME=rs3_wayfinder_remember
REMEMBER_COOKIE_LIFETIME_SECONDS=2592000
